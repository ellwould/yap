# YAP (Yet Another PBX) Configuration File

################
# YAP Settings #
################

# YAP IP address/domain name
# Example format: localhost
# Example format: 127.0.0.1
yapAddress = 'localhost'

# YAP port number to listen on (number between 1024-49151)
yapPort = '8005'

# YAP public facing URL and optional port
# Example format: https://example.com
# Example format: https://example.com:443
# Can be empty
yapPublicURL = 'https://<REPLACE_FQDN>'

# This option sets the default extension limit when creating a new PBX
# Valid options are 1, 2, 3, 4, 5, 10, 25, 50, 75, 100, 150, 200, 250, 500, 750, 1000, 1500, 2000, 2500, 5000
defaultExtLimit = '5'

# This option sets the currency symbol to use
# Valid options are £, €, $, ¥ and can also be empty 
currencySymbol = '£'

# This option is for if the YAP admin is UK VAT registered
# If this option is set to yes then sell prices on the invoice page must be input excluding VAT
# Valid options are 'no' and 'yes'
yapAdminUKVATRegistered = '<REPLACE_VAT_REGISTERED_STATUS>'

# Optional extra button name in header
# Leave blank if no extra button in the header is needed
extraButtonName = ''

# Optional extra button URL in header
# A valid URL must be supplied if the extraButtonName is not blank
# Valid Examples:
# https://localhost:443
# http://localhost:80
# http://127.0.0.1:80
extraButtonURL = ''

#####################
# Database Settings #
#####################

# Database name
dbName = 'yap'

# Database IP address/domain name
dbAddress = 'localhost'

# Database port number
dbPort = '3306'

# Database transport protocol (udp/tcp)
dbTransport = 'tcp'

# TLS option (false/true)
# When using TLS with a self-signed certificate the CA certificate must be installed on the OS
# For instructions on adding a self-signed CA certificate see:
# https://github.com/yet-another-pbx/yap/blob/main/README.md#adding-the-yap-self-signed-ca-certificate-to-the-certificate-store
dbTLS = 'false'

# Database username
# May require single quotation marks around a complex database username, example: 'yapyapyap$1'
dbUsername = 'yap'

# Database password
# May require single quotation marks around a complex database password, example: 'HopefullyASecurePasswordIsUsed$1'
dbPassword = '<REPLACE_DB_YAP_PASSWORD>'

################################
# Accounting Software Settings #
################################

# The URL for the accounting software API
# Example format: https://example.com/v2
# Can be empty
accountingSoftwareAPIURL = ''

# The client ID for the accounting software API
# Can be empty
accountingSoftwareAPIClientID = ''
                
# The client secret for the accounting software API
# Can be empty
accountingSoftwareAPIClientSecret = ''

# The currency code to bill in for the accounting software API
# Valid options are GBP, EUR, USD, JPY and can also be empty
accountingSoftwareCurrencyCode = 'GBP'
